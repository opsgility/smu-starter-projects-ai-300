# Copy this file to .env and fill each <...> placeholder from the
# Environment tab of the AI-300 Lesson 11 lab. Do NOT commit .env.

# Foundry project + model deployments (from the ARM template outputs)
AZURE_AI_PROJECT_ENDPOINT=<foundryProjectEndpoint from Environment tab>
AZURE_AI_CHAT_DEPLOYMENT=gpt-5.1
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure subscription context (needed by safety evaluators — they call
# the hosted Foundry Evaluation Service, not your own model).
AZURE_SUBSCRIPTION_ID=<subscription id from Environment tab>
AZURE_RESOURCE_GROUP=<resource group name from Environment tab>
AZURE_PROJECT_NAME=dispatcher

# Application Insights (used by Exercise 7 KQL queries + OTel tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=<appInsightsConnectionString from Environment tab>

# The Dispatcher API deployed by the ARM template. Exercise 7 hits it
# to generate telemetry that the KQL dashboards then query.
DISPATCHER_API_URL=<dispatcherApiUrl from Environment tab>

# Meridian Freight contractual ceiling. Read by MeridianComplianceEvaluator
# to fail any Dispatcher response that quotes a rate above this number
# (USD per mile). Never quote above this rate.
MAX_QUOTE_USD_PER_MILE=4.20
