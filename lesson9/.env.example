# -------- Foundry / model plane --------
# Foundry project endpoint URL. Format:
# https://<account>.services.ai.azure.com/api/projects/<project-name>
# Injected by the lab at container start; set here only if running outside the lab.
FOUNDRY_PROJECT_ENDPOINT=https://meridian-foundry-XXXX.services.ai.azure.com/api/projects/dispatcher

# Name of the chat deployment attached to the dispatcher project.
FOUNDRY_CHAT_DEPLOYMENT=gpt-5.1

# Name of the embedding deployment attached to the dispatcher project (used by
# downstream lessons, listed here for completeness).
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# -------- App Insights / OpenTelemetry --------
# Connection string emitted by the pre-provisioned App Insights component.
# The API in src/api/main.py reads this via configure_azure_monitor().
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/

# -------- Deployment target --------
# Resource group the lab pre-provisioned. Every az call in the deploy workflow
# reads AZURE_RESOURCE_GROUP as a repo variable, but keep it here for local runs.
AZURE_RESOURCE_GROUP=meridian-dispatcher-rg
