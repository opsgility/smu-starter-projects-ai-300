# -------- OIDC / Azure identity --------
# UAMI (User-Assigned Managed Identity) client ID — the identity GitHub Actions
# assumes via workload identity federation. Pre-provisioned by the lab.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Azure AD tenant ID.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure subscription ID the workspace deploys into.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# -------- Deployment target --------
# Resource group the lab created for you. `az deployment group create`
# and the workflow both target this RG.
AZURE_RESOURCE_GROUP=meridian-mlops-rg

# Per-instance suffix the lab injects. Final workspace name is
# meridian-mlws-<WORKSPACE_NAME_SUFFIX>. Keep it 4–8 lowercase alphanumeric.
WORKSPACE_NAME_SUFFIX=abcd
